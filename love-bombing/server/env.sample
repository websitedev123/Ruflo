# Copy to .env and fill in to enable the real Claude-powered engine:
#   cp env.sample .env
# Without a key, the app runs in built-in "demo" mode (no external AI).

# Your Anthropic API key (https://console.anthropic.com/).
ANTHROPIC_API_KEY=

# Optional: override the model. Defaults to claude-opus-5-5.
# For a cheaper/faster option try: claude-sonnet-5-5 or claude-haiku-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: port the server listens on (default 4000).
PORT=4000
